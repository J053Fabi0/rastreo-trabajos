{
  "unstable": ["kv", "ffi", "cron"],
  "tasks": {
    "stop": "pm2 stop trabajos",
    "start": "pm2 start --interpreter='deno' --interpreter-args='run -A' --name trabajos index.ts && pm2 logs trabajos",
    "delete": "pm2 delete trabajos",
    "logs": "pm2 logs trabajos",
    "reload": "pm2 reload trabajos && pm2 logs trabajos",
    "check": "deno check --allow-import index.ts",
    "run": "deno run -A index.ts",
    "watch": "deno run --watch -A index.ts",
    "run:molt": "deno run --allow-env --allow-read --allow-write --allow-run --allow-net jsr:@molt/cli",
    "update_deps": "deno task -q run:molt ./**/*.ts --write --no-lock && deno task check"
  },
  "imports": {
    "@b-fuze/deno-dom": "jsr:@b-fuze/deno-dom@^0.1.56",
    "@coven/math": "jsr:@coven/math@^0.8.5",
    "@es-toolkit/es-toolkit": "jsr:@es-toolkit/es-toolkit@^1.45.1",
    "@olli/kvdex": "jsr:@olli/kvdex@^3.4.2",
    "@retraigo/bettermap": "jsr:@retraigo/bettermap@^1.3.2",
    "@spawn/curl": "jsr:@spawn/curl@^0.0.2",
    "@std/assert": "jsr:@std/assert@^1.0.13",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.2",
    "@grammyjs/parse-mode": "npm:@grammyjs/parse-mode@^2.2.0",
    "@std/path": "jsr:@std/path@^1.0.8",
    "dayjs": "npm:dayjs@^1.11.20",
    "grammy/": "https://deno.land/x/grammy@v1.41.1/",
    "moment": "npm:moment@^2.30.1",
    "moment-timezone": "npm:moment-timezone@^0.5.46",
    "humanizer/": "https://deno.land/x/humanizer@1.1/",
    "grammy_auto_retry": "https://deno.land/x/grammy_auto_retry@v2.0.2/mod.ts"
  }
}
